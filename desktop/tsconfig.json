{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/main.ts", "src/preload.ts", "src/agent-ui.ts", "src/decoder-readiness.ts", "src/fold-change.ts", "src/kmer-tree-layout.ts", "src/net-errors.ts"]
}
